<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Switchboard</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Sans ceci, les cibles MSBuild qui generent le manifeste d'activation WinUI3
         (requis meme non packagee) ne se declenchent pas — trouve en comparant avec
         l'exemple officiel microsoft/WindowsAppSDK-Samples/.../cs-winui-unpackaged. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Sans ceci, l'app exige que l'utilisateur installe le Windows App Runtime a part ;
         avec, il est copie dans le dossier de sortie, comme dotnet publish self-contained. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon via WinForms NotifyIcon (WinUI3 n'a pas d'API pour ca) ; reference directe
         au framework, pas <UseWindowsForms>true</UseWindowsForms>, qui declenche a tort le
         compilateur XAML WPF sur nos .xaml WinUI3. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Attend que le crate `ffi` soit deja compile en release pour x86_64-pc-windows-msvc. -->
    <None Include="..\target\release\switchboard_ffi.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\target\release\switchboard_ffi.dll')" />
    <None Include="..\icons\icon.ico" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\icons\icon.ico')" />
  </ItemGroup>

</Project>
